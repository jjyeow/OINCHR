{
  "expo": {
    "name": "OINCHR",
    "slug": "OINCHR",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "farm.oinc.hr",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "farm.oinc.hr",
      "adaptiveIcon": {
        "backgroundColor": "#5EB894",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "OINCHR needs photo access so you can attach an MC or receipt to an application.",
          "cameraPermission": "OINCHR uses the camera so you can photograph an MC or receipt."
        }
      ],
      "expo-font"
    ]
  }
}
